# ==========================================================
#  WolfISMS – Vorlage, nach ".env" kopieren und anpassen
#  Alle mit ANPASSEN markierten Werte müssen gesetzt werden,
#  sonst bricht "docker compose up" ab oder die App verhält
#  sich falsch.
# ==========================================================

# ANPASSEN: Netzwerk-Alias, unter dem NPM die App im Netz "proxy"
# erreicht. Genau dieser Name gehört im Proxy Host unter
# "Forward Hostname", der Port dort ist 8000 (siehe NPM.md).
PROXY_ALIAS=

# ANPASSEN: Öffentliche Basis-URL der Instanz, ohne abschließenden "/".
# Wird für die Links in Benachrichtigungs-Mails benutzt – bleibt sie leer,
# verschicken Aufgaben- und Dokumenten-Mails Links ohne Hostnamen.
WEBPATH=https://isms.deine-domain.tld

# Optional: fester Host-Port für die Diagnose auf dem Docker-Host. Er hängt
# immer an 127.0.0.1 – der Zugriff von außen läuft ausschließlich über NPM.
# Leer lassen, wenn mehrere Umgebungen auf demselben Host laufen – dann
# vergibt Docker einen freien Port. Jeder feste Port darf je Host nur
# einmal vorkommen.
WOLFISMS_HOST_PORT=

WOLFISMS_IMAGE=wolfinfosecgmbh/wolfisms:release

# --- Datenbank ---
# DB_MODUS wählt die Betriebsart (fehlt der Eintrag, gilt "intern"):
#
#  intern  MariaDB läuft als Container "db" im Stack, DB_HOST bleibt leer.
#          Der Container legt Datenbank und User beim ersten Start selbst an
#          (ein Dump in ./db-init wird dabei eingespielt). Das Dump enthält nur
#          Daten/Schema, NICHT die MySQL-Benutzer – Name/Passwort frei wählbar.
#
#  extern  Es startet KEIN DB-Container. DB_HOST/DB_PORT zeigen auf den
#          externen Server; Datenbank DB_NAME und User DB_USER müssen dort
#          bereits existieren, z. B.:
#            CREATE DATABASE isms CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#            CREATE USER 'isms'@'%' IDENTIFIED BY '…';
#            GRANT ALL PRIVILEGES ON isms.* TO 'isms'@'%';
#          Bestehende Daten vorher per Dump auf den Server übertragen.
#          Das Backup im Admin-Bereich (mariadb-dump --routines) braucht
#          Leserechte auf die Routinen; DB_ROOT_PASSWORD wird nicht benutzt.
#
# Wechsel einer laufenden Umgebung: erst "docker compose down" (Daten im
# Volume db_data bleiben erhalten), dann DB_MODUS ändern, dann
# "docker compose up -d".
DB_MODUS=intern

# Datenbanktyp: mariadb (Standard) oder mysql. Vorgesehen für spätere
# Versionen: mssql – wird derzeit beim Start mit einer Meldung abgelehnt.
DB_TYPE=mariadb

# Leer = interner Container "db". Bei extern: Hostname oder IP des DB-Servers.
DB_HOST=
# Leer = Standardport des Typs (MariaDB/MySQL: 3306).
DB_PORT=

# ANPASSEN: Passwort setzen (erzeugen z. B. mit "openssl rand -hex 24").
# Bei intern gilt es für App UND DB-Container (beide lesen dieselbe Variable),
# bei extern ist es das Passwort des Users auf dem externen Server.
DB_NAME=isms
DB_USER=isms
DB_PASSWORD=
# ANPASSEN bei intern: root-Passwort des DB-Containers. Bei extern ungenutzt.
DB_ROOT_PASSWORD=

# TLS zur Datenbank (vor allem bei extern):
#   leer         Verhalten von Treiber/Client unverändert
#   disabled     ohne TLS
#   required     TLS erzwingen, Zertifikat nicht prüfen
#   verify-full  TLS, Zertifikat und Hostname gegen DB_SSL_CA prüfen
# Zertifikate nach ./db-certs legen; im Container: /var/www/isms/db-certs/…
DB_SSL_MODE=
DB_SSL_CA=
# Optional, nur wenn der Server Client-Zertifikate verlangt:
DB_SSL_CERT=
DB_SSL_KEY=

# --- Sprache ---
ENGLISCH=true
DEUTSCH=true

# --- Single Sign-On ---
# Alles in diesem Abschnitt lässt sich auch im Admin-Bereich unter
# "SSO" (/admin/sso) pflegen. Ist dort der Schalter
# "Einstellungen dieser Seite verwenden" gesetzt, gelten ausschließlich
# die dort gespeicherten Werte – sie überschreiben diesen Abschnitt
# vollständig, auch MS_AUTH und GOOGLE_AUTH. Ist er aus, gilt das, was
# hier steht. Vorteil der Oberfläche: Änderungen greifen sofort, ohne
# "docker compose up -d". Welche Quelle gerade wirkt, zeigt die Seite an.
#
# Beide Anbieter sind aus. Zum Aktivieren auf "true" setzen UND die
# zugehörige Client-ID samt Secret eintragen – ein aktivierter Anbieter
# ohne Zugangsdaten zeigt einen Login-Button, der beim Klick fehlschlägt.
#
# MS_TENANT_ID ist bei MS_AUTH=true Pflicht: Directory-(Tenant-)ID aus
# Entra (GUID), alternativ eine verifizierte Domain oder "common".
# Ohne diesen Wert findet die App den Anmeldedienst nicht.
MS_AUTH=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: abweichende Redirect-URI. Leer = aus WEBPATH abgeleitet,
# also "<WEBPATH>/auth/google/callback".
GOOGLE_REDIRECT_URI=

# Kommagetrennte Liste der E-Mail-Domains, die sich per SSO anmelden
# dürfen. LEER heißt: niemand – ein eingeschaltetes SSO ohne Eintrag
# weist jede Anmeldung ab.
SSO_ALLOWED_DOMAINS=
# true: unbekannte Benutzer werden bei der ersten SSO-Anmeldung
# automatisch mit Nur-Lese-Recht angelegt.
SSO_AUTO_CREATE=false

# --- Optional ---
# Flask-Session-Key. Leer lassen ist in Ordnung: die App erzeugt dann beim
# ersten Start selbst einen Schlüssel und legt ihn im Volume "sessions" ab,
# er überlebt also Neustarts und Updates. Nur setzen, wenn derselbe Key
# über mehrere Instanzen hinweg gelten soll (erzeugen mit:
#   python3 -c "import secrets;print(secrets.token_hex(32))" ).
ISMS_SECRET_KEY=
GUNICORN_CMD_ARGS=--workers 4 --worker-class gthread --threads 8
